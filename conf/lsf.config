// Configuration for Load Sharing Facility (LSF) workload management platform

executor {
    name = 'lsf'

    // Set total number of jobs that can be simultaneously run
    queueSize = 1000
    killBatchSize = 1000

    // Set perJobMemLimit to true. See:
    // * https://github.com/nextflow-io/nextflow/issues/123
    // * https://gitter.im/nextflow-io/nextflow/archives/2018/02/09
    perJobMemLimit = true

} // end executor

singularity {
    enabled     = true
    autoMounts  = true
    // USER should set this via NXF_SINGULARITY_CACHEDIR
    // cacheDir = '/path/to/cache'
    runOptions = '--dns 172.18.255.1,172.18.255.2,172.18.255.3 --bind /lustre/scratch125/humgen/projects_v2/ibdresponse/analysis/bradley_analysis/sc_nf_diffexpression/packages/python_libs:/extra_packages'
    envWhitelist = 'HOSTNAME,SSH_CONNECTION,SSH_CLIENT,CVS_RSH,http_proxy,https_proxy,HTTP_PROXY'
}

env {
    NUMBA_CACHE_DIR = '/lustre/scratch125/humgen/projects_v2/ibdresponse/analysis/bradley_analysis/sc_nf_diffexpression/numba_cache'
    MPLCONFIGDIR = '/lustre/scratch125/humgen/projects_v2/ibdresponse/analysis/bradley_analysis/sc_nf_diffexpression/matplotlib_cache'
    XDG_CACHE_HOME = '/tmp'
    PYTHONPATH = '/extra_packages'
}

process {
    executor = 'lsf'
    container = '/lustre/scratch125/humgen/projects_v2/ibdresponse/analysis/bradley_analysis/sc_nf_diffexpression/sc_nf_diffexpression_1.0.0-update.sif'

    // lsf users will need to edit the below parameters to fit their platform
    queue = 'normal'
    // native configuration options
    //clusterOptions = { "-R \"select[mem>${task.memory.toMega()}]\"" }
    //clusterOptions = { "-R \"span[hosts=1]\"" }

    // specific settings for processes with specific labels such as
    // big_mem, short, long
    //withLabel: big_mem {
    //    cpus = 16
    //    memory = 64.GB
    //    queue = 'hugemem'
    //}
} // end process
