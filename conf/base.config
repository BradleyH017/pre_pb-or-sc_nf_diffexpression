// General resource configuration applicable to all profiles

process {
    // error strategy
    errorStrategy = 'retry'
    //errorStrategy = 'terminate'
    maxRetries = 3

    // basic resources
    cpus = 1
    memory = { 75.GB * task.attempt }

    // basic output settings
    publish_mode = "copy" // symlink or copy

    // process-specific resources
    withName: add_experiment_covariates {
        // Loads the full anndata once for the whole run (previously done
        // once per cell_label x model inside run_differential_expression).
        memory = { 100.GB * task.attempt }
        cpus = 1
    }
    withName: prep_expression {
        // Loads the full anndata and subsets/writes matrices once per cell
        // type (previously done once per cell_label x model inside
        // run_differential_expression).
        memory = { 100.GB * task.attempt }
        cpus = 1
    }
    withName: run_differential_expression {
        memory = { 120.GB * task.attempt }
        // memory = 75.GB
        cpus = 8
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'retry' }
        maxRetries = 3
    }
    withName: run_fgsea {
        memory = 40.GB
        cpus = 8
    }
    withName: merge_de_dataframes {
        // Do not retry: retrying this process is known to make failures
        // worse, not better -- see the NOTE in the merge_de_dataframes
        // process definition. Re-invoking it after a first-attempt failure
        // causes its reduce()/flatMap()-derived inputs to come through
        // empty, turning a clear, diagnosable error into a confusing one.
        // Fail fast on the first attempt instead.
        errorStrategy = 'terminate'
        maxRetries = 0
    }

    withName: plot_dge_results {
        memory = 60.GB
    }

} // end process

timeline {
    enabled = true
}
